<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Container: Links/Rechts über IsNativeOrigin -->
    <Style x:Key="ChatItemContainer" TargetType="ListViewItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>

        <Style.Triggers>
            <DataTrigger Binding="{Binding IsNativeOrigin}" Value="True">
                <Setter Property="HorizontalContentAlignment" Value="Right"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Message-Layout -->
    <DataTemplate x:Key="ChatMessageTemplate">
        <StackPanel Margin="8" MaxWidth="420">

            <!-- Header (Name + Zeit) nur bei FirstMessage -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FirstMessage}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="{Binding Username}" FontWeight="SemiBold"/>
                <TextBlock Text="  ·  " Opacity="0.6"/>
                <TextBlock Text="{Binding Time, StringFormat={}{0:HH:mm}}" Opacity="0.6" FontSize="11"/>
            </StackPanel>

            <!-- Bubble -->
            <Border Padding="10" CornerRadius="14">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#E8E8E8"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNativeOrigin}" Value="True">
                                <Setter Property="Background" Value="#CFE3FF"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
            </Border>

        </StackPanel>
    </DataTemplate>

</ResourceDictionary>