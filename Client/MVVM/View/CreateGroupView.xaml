<Window x:Class="WPF_Fusion.MVVM.View.CreateGroupView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Group"
        Height="290"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="#FFF5F5F5">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Create a group"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <TextBlock Grid.Row="1"
                   Text="Group name"
                   Foreground="#444444"/>

        <TextBox Grid.Row="2"
                 Height="34"
                 Margin="0,4,0,12"
                 Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                 VerticalContentAlignment="Center"
                 FontSize="14"
                 Style="{StaticResource UnderlineTextBoxStyle}"
                 BorderBrush="#555555"
                 Foreground="Black"/>

        <TextBlock Grid.Row="3"
                   Text="Members (usernames, separated by commas)"
                   Foreground="#444444"/>

        <TextBox Grid.Row="4"
                 Height="34"
                 Margin="0,4,0,0"
                 Text="{Binding Members, UpdateSourceTrigger=PropertyChanged}"
                 VerticalContentAlignment="Center"
                 FontSize="14"
                 Style="{StaticResource UnderlineTextBoxStyle}"
                 BorderBrush="#555555"
                 Foreground="Black"/>

        <TextBlock Grid.Row="5"
                   Text="{Binding ErrorMessage}"
                   Foreground="DarkRed"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"/>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">

            <Button Content="Cancel"
                    Width="90"
                    Margin="0,0,10,0"
                    Command="{Binding CancelCommand}" />

            <Button Content="Create"
                    Width="90"
                    Command="{Binding OkCommand}" />
        </StackPanel>
    </Grid>
</Window>
