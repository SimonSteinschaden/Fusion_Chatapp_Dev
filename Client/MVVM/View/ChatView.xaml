<UserControl x:Class="WPF_Fusion.MVVM.View.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodel="clr-namespace:WPF_Fusion.MVVM.ViewModel"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             d:DataContext="{d:DesignInstance Type=viewmodel:ChatViewModel, IsDesignTimeCreatable=True}"
             Loaded="ChatView_Loaded">

    <Border x:Name="RootBorder"
            CornerRadius="20"
            Background="Transparent"
            SnapsToDevicePixels="True"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">

        <Grid Background="White"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch" Opacity="0.9">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="75"/>
            </Grid.RowDefinitions>

            <!-- LEFT: Contacts header -->
            <Grid>

                <Label Grid.Column="0"
                   Content="Contacts"
                   VerticalAlignment="Center"
                   FontWeight="Medium"
                   Foreground="#FF003120"
                   Margin="8,0,0,0"
                   Height="26"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="Add"
                        ToolTip="Start a direct chat with the username on the right"
                        Command="{Binding AddCommand}"
                        Background="#FF003120"
                        Foreground="White"
                        Padding="10,0"
                        Margin="12,10,4,8"/>
                <Button Grid.Column="1"
                        Content="Group"
                        ToolTip="Create a group conversation"
                        Command="{Binding CreateGroupCommand}"
                        Background="#FF003120"
                        Foreground="White"
                        Padding="10,0"
                        Margin="0,10,8,8"/>
                <TextBox Grid.Column="2"
                         Height="30"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource AddUserTextBox}"
                         MinWidth="0"
                         HorizontalAlignment="Stretch"
                         VerticalContentAlignment="Bottom">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding AddCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </Grid>

            <!-- LEFT: Contacts list -->
            <ListView Grid.Column="0" Grid.Row="2"
                      ItemsSource="{Binding Contacts}"
                      SelectedItem="{Binding SelectedContact}"
                      Background="Transparent"
                      BorderThickness="0"
                      Margin="8"
                      ItemContainerStyle="{StaticResource ContactCard}"
                      HorizontalContentAlignment="Stretch"/>

            <!-- LEFT: Bottom user bar -->
            <Border Grid.Column="0" Grid.Row="3"
                    Background="#292B2F"
                    Padding="12"
                    SnapsToDevicePixels="True">
                <StackPanel Orientation="Horizontal">
                    <Border CornerRadius="25"
                            Width="30" Height="30"
                            Background="Aquamarine"
                            Margin="6,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <Label Content="{Binding DataContext.CurrentUsername, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="White"
                               FontWeight="SemiBold"
                               Margin="0,-5,0,-5"/>
                        <Label Content="CustomerStatus"
                               Foreground="Gray"
                               FontSize="10"
                               Margin="0,-8,0,-5"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- RIGHT: Chat area spans all rows -->
            <Grid Grid.Column="1" Grid.Row="0" Grid.RowSpan="4"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">

                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto" MinHeight="82"/>
                </Grid.RowDefinitions>

                <!-- RIGHT: Header -->
                <Border Grid.Row="0"
                        BorderBrush="#2F3136"
                        BorderThickness="0,0,0,2"
                        Background="Transparent">
                    <Grid Margin="5,8,11,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0"
                               Content="{Binding SelectedContact.Username, FallbackValue='@Username'}"
                               Foreground="Black"
                               FontWeight="Bold"
                               Margin="5,0,5,0"
                               VerticalAlignment="Stretch"/>

                        <!-- Call and video buttons removed until they do something.
                             See TODO.md 3.12 / 5.6. -->
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   FontSize="11"
                                   Foreground="#666666"
                                   Text="{Binding SelectedContact.LastMessageAt, StringFormat='last activity {0:dd.MM. HH:mm}'}"/>
                    </Grid>
                </Border>

                <!-- RIGHT: Messages -->
                <Grid Grid.Row="1">
                    <ListView x:Name="MessageList"
                              ItemsSource="{Binding SelectedContact.Messages}"
                              Background="Transparent"
                              BorderThickness="0"
                              Margin="8,0,0,0"
                              ItemContainerStyle="{StaticResource ChatItemContainer}"
                              ItemTemplate="{StaticResource ChatMessageTemplate}"
                              HorizontalContentAlignment="Stretch"/>

                    <!-- Status banner: makes connection problems visible instead of
                         showing an empty list. -->
                    <Border VerticalAlignment="Top"
                            Margin="8,8,8,0"
                            Padding="10,6"
                            CornerRadius="6"
                            Background="#FFF3CD"
                            BorderBrush="#E0C97F"
                            BorderThickness="1"
                            Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="#6B5200"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- Busy indicator -->
                    <Border VerticalAlignment="Bottom"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,8"
                            Padding="10,4"
                            CornerRadius="10"
                            Background="#DD003120"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Loading…" Foreground="White" FontSize="11"/>
                    </Border>
                </Grid>

                <!-- RIGHT: Input -->
                <Border Grid.Row="2"
                        Background="Transparent"
                        Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Attachment button removed until file upload exists.
                             See TODO.md 3.12 / 5.6. -->
                        <TextBox Grid.Column="0"
                                 Height="50"
                                 Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MessageBox}"
                                 MinWidth="0"
                                 HorizontalAlignment="Stretch"
                                 VerticalContentAlignment="Center">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SendCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <Button Grid.Column="1"
                                Width="32"
                                Height="32"
                                Background="Transparent"
                                BorderThickness="0"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Command="{Binding SendCommand}">
                            <Image Source="/Icons/send.png"
                                   Width="20"
                                   Height="20"
                                   RenderOptions.BitmapScalingMode="Fant"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
