<!-- LoginWindow.xaml -->
<Window x:Class="WPF_Fusion.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:viewmodel="clr-namespace:WPF_Fusion.MVVM.ViewModel" d:DataContext="{d:DesignInstance Type=viewmodel:LoginViewModel}"
        xmlns:infra="clr-namespace:WPF_Fusion.Infrastructure"
        mc:Ignorable="d"
        Title="Login to Fusion"
        Width="900"
        Height="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#212529"
        Foreground="White">
    <Window.Resources>
        <!-- Summary: bool -> Visibility converter for HasError binding -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Grid>

        <!-- Video background -->
        <MediaElement x:Name="BgVideo"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Manual"
                      Stretch="UniformToFill"
                      IsMuted="True"
                      Volume="0"
                      ScrubbingEnabled="True"
                      Panel.ZIndex="0" />


        <!-- Summary: Login UI in own Window (on startup) -->
    <Grid Margin="24">
        <Border Width="360"
                Padding="24"
                CornerRadius="10"
                BorderThickness="1"
                BorderBrush="#334"
                Background="#2A2F35"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>
                <TextBlock Text="Welcome to Fusion"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12"/>

                <!-- Email -->
                <TextBlock Text="Email" Opacity="0.8"/>
                <TextBox Margin="0,6,0,14"
                         Height="34"
                         Padding="10,0"
                         VerticalContentAlignment="Center"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource UnderlineTextBoxStyle}"/>

                    <!-- Password: Umschalten über ShowPassword -->
                    <Grid>
                        <!-- PasswordBox (default: visible) -->
                        <PasswordBox x:Name="PwBox" Tag="Enter Password"
                                infra:PasswordBoxHelper.BindPassword="True"
                                infra:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                VerticalContentAlignment="Center" HorizontalContentAlignment="Left" >
                            <!--<PasswordBox.InputBindings>
                                <KeyBinding Key="Enter"
                                            Command="{Binding LoginCommand}" />
                            </PasswordBox.InputBindings>-->
                            
                            <PasswordBox.Style>
                                <Style TargetType="PasswordBox" BasedOn="{StaticResource UnderlinePasswordBoxStyle}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowPassword}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </PasswordBox.Style>
                        </PasswordBox>

                        <!-- Visible password (default: collapsed) -->
                        <TextBox Tag="Enter Password"
                            Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                            VerticalContentAlignment="Center" HorizontalContentAlignment="Left" >
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource UnderlineTextBoxStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowPassword}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>

                    <CheckBox Content="Show password" Foreground="GhostWhite" IsChecked="{Binding ShowPassword}"/>
                 
                <!-- Actions. The password comes from the bound Password property,
                     so no CommandParameter is needed. -->
                <Button Content="Login"
                        Height="36"
                        Margin="0,6,0,0"
                        Command="{Binding LoginCommand}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Content="Register"
                            Margin="0,0,10,0"
                            Command="{Binding RegisterCommand}"/>
                    <Button Content="Forgot Password"
                            Command="{Binding ForgotPasswordCommand}"/>
                </StackPanel>

                <!-- Progress -->
                <TextBlock Text="Contacting server…"
                           Foreground="GhostWhite"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>

                <!-- Error -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="Salmon"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </Border>
    </Grid>
    </Grid>
</Window>
